From cf3a7592205219ba5b0aefd326766f2aa58d8c09 Mon Sep 17 00:00:00 2001
From: Jonathan Helmus <jjhelmus@gmail.com>
Date: Wed, 31 Oct 2018 15:35:41 -0500
Subject: [PATCH] [PATCH] Make load_lib() CONDA_PREFIX aware

Co-authored-by: Jaida Rice <jrice@anaconda.com>
---
 lib/Crypto/Util/_raw_api.py | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/lib/Crypto/Util/_raw_api.py b/lib/Crypto/Util/_raw_api.py
index 072c6f69..54765d23 100644
--- a/lib/Crypto/Util/_raw_api.py
+++ b/lib/Crypto/Util/_raw_api.py
@@ -283,7 +283,17 @@ except ImportError:
             cached_architecture[:] = platform.architecture()
         _bits, linkage = cached_architecture
         if "." not in name and not linkage.startswith("Win"):
-            full_name = find_library(name)
+            _name = name
+            if 'lib' not in _name:
+                _name = 'lib' + _name
+            if sys.platform == 'darwin':
+                _name += '.dylib'
+            elif sys.platform.startswith('linux'):
+                _name += '.so'
+            full_name = os.path.join(os.environ['CONDA_PREFIX'], 'lib', _name)
+            # If not found in $CONDA_PREFIX/lib, find it via ctypes.util
+            if not os.path.isfile(full_name):
+                full_name = find_library(name)
             if full_name is None:
                 raise OSError("Cannot load library '%s'" % name)
             name = full_name
-- 
